      "城阙辅三秦，风烟望五津"
    ],
    "山": [
      "白日依山尽，黄河入海流",
      "千山鸟飞绝，万径人踪灭",
      "只在此山中，云深不知处",
      "两岸青山相对出，孤帆一片日边来",
