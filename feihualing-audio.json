  "pairs": {
    "月": [
      "解落三秋叶，能开二月花",
      "不知细叶谁裁出，二月春风似剪刀",
      "小时不识月，呼作白玉盘",
      "湖光秋月两相和，潭面无风镜未磨",
      "停车坐爱枫林晚，霜叶红于二月花",
      "人间四月芳菲尽，山寺桃花始盛开",
      "春风又绿江南岸，明月何时照我还",
      "乡村四月闲人少，才了蚕桑又插田",
      "大漠沙如雪，燕山月似钩",
      "八月秋高风怒号，卷我屋上三重茅",
      "缺月挂疏桐，漏断人初静",
      "从今若许闲乘月，拄杖无时夜叩门",
      "床前明月光，疑是地上霜",
      "深林人不知，明月来相照",
      "故人西辞黄鹤楼，烟花三月下扬州",
      "月落乌啼霜满天，江枫渔火对愁眠",
      "野旷天低树，江清月近人",
      "回乐烽前沙似雪，受降城外月如霜"
    ],
    "春": [
      "不知细叶谁裁出，二月春风似剪刀",
      "野火烧不尽，春风吹又生",
      "春种一粒粟，秋收万颗子",
      "迟日江山丽，春风花草香",
      "黄师塔前江水东，春光懒困倚微风",
      "日出江花红胜火，春来江水绿如蓝",
      "阳春布德泽，万物生光辉",
      "好雨知时节，当春乃发生",
      "最是一年春好处，绝胜烟柳满皇都",
      "落红不是无情物，化作春泥更护花",
      "几处早莺争暖树，谁家新燕啄春泥",
      "箫鼓追随春社近，衣冠简朴古风存",
      "春眠不觉晓，处处闻啼鸟",
      "谁言寸草心，报得三春晖",
      "东风不与周郎便，铜雀春深锁二乔",
      "春潮带雨晚来急，野渡无人舟自横",
      "春城无处不飞花，寒食东风御柳斜",
      "随意春芳歇，王孙自可留"
    ],
    "花": [
      "解落三秋叶，能开二月花",
      "桃花潭水深千尺，不及汪伦送我情",
      "接天莲叶无穷碧，映日荷花别样红",
      "迟日江山丽，春风花草香",
      "桃花一簇开无主，可爱深红爱浅红",
      "日出江花红胜火，春来江水绿如蓝",
      "晓看红湿处，花重锦官城",
      "西塞山前白鹭飞，桃花流水鳜鱼肥",
      "茅檐长扫净无苔，花木成畦手自栽",
      "落红不是无情物，化作春泥更护花",
      "有约不来过夜半，闲敲棋子落灯花",
      "兴尽晚回舟，误入藕花深处",
      "夜来风雨声，花落知多少",
      "故人西辞黄鹤楼，烟花三月下扬州",
      "正是江南好风景，落花时节又逢君",
      "商女不知亡国恨，隔江犹唱后庭花",
      "春城无处不飞花，寒食东风御柳斜",
      "感时花溅泪，恨别鸟惊心"
    ],
    "风": [
      "不知细叶谁裁出，二月春风似剪刀",
